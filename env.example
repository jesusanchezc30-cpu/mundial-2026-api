# ============================================================
# PROYECTO MUNDIAL 2026 — Variables de entorno
# Copia este archivo como .env y rellena tus valores
# NUNCA subas el .env a GitHub
# ============================================================

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mundial
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# Anthropic API (para generación de curiosidades y narrativas)
ANTHROPIC_API_KEY=sk-ant-...

# Open-Meteo (clima) — no necesita API key, es gratuita
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Configuración scraping
SCRAPING_DELAY_SEGUNDOS=2
SCRAPING_REINTENTOS=3
